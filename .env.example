# Copy to .env (local) or set in Vercel project settings (production). Never commit real values.
# Placeholders only. Values here are examples, not working credentials.

# --- Owner -------------------------------------------------------------------------------------
# The owner's verified email. Whoever signs in with this email (verified in Clerk) is admitted as
# admin and verifier. Without it nobody can be admitted on a closed pilot.
OWNER_EMAIL=owner@example.com

# --- Supabase: Project Settings -> API. Server-side only. Never expose to the browser. -----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# Legacy name, accepted as a fallback:
# SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk: API Keys. Publishable key is safe for the browser; secret key is server-only. --------
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=

# --- Email (Resend) ------------------------------------------------------------------------------
# Master switch. Default is OFF: with it off (or unset) the app sends no email by any path, even if
# RESEND_API_KEY is set. Turn on only after the owner has approved real email.
# Accepted "on" values: true, 1, yes, on.
EMAIL_ENABLED=false
# Resend: API Keys, and a sending address on a domain you have verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Funds For Family <no-reply@YOUR-VERIFIED-SUBDOMAIN>

# --- Daily job -----------------------------------------------------------------------------------
# Shared secret for the daily job (Authorization: Bearer <value>). Long random string.
# Used by the daily job (WP-6); set it before that job is deployed.
# CRON_SECRET=

# --- App -----------------------------------------------------------------------------------------
APP_URL=http://localhost:3000
PORT=3000
# Verification approvals needed before a request opens (default 2).
REQUIRED_APPROVALS=2
# Set by Vercel itself (production, preview, development). Do not set by hand.
# VERCEL_ENV=
