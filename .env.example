# Copy to .env (local) or set in Vercel project settings (production). Never commit real values.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clerk: API Keys. Publishable key is safe for the browser; secret key is server-only.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=

# Resend: API Keys, and a sending address on a domain you have verified in Resend
RESEND_API_KEY=
EMAIL_FROM=Funds For Family <no-reply@YOUR-VERIFIED-DOMAIN>

# App
APP_URL=http://localhost:3000
PORT=3000
INTEREST_RATE_ANNUAL=0.12
REQUIRED_APPROVALS=2
